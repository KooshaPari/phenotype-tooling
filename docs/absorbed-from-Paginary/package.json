{
  "name": "paginary",
  "version": "0.0.1",
  "description": "Phenotype knowledge collection — handbooks, specs, X-driven dev guides, and user journeys",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.1.20",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "preview": "turbo run preview",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "turbo": "^2.0.0",
    "vitepress": "^1.6.4",
    "vue": "^3.4.21"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "vite": "^6.4.2",
    "esbuild": "^0.25.0"
  }
}

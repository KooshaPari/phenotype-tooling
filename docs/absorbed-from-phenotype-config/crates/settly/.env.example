# Example environment configuration for settly.
# Copy this file to `.env` and uncomment the variables you need.

# ------------------------------------------------------------------------------
# Framework Settings (overrides settly.toml defaults)
# ------------------------------------------------------------------------------

# SETTLY_IDEMPOTENCY_TTL_SECS=86400
# SETTLY_MAX_RETRIES=3
# SETTLY_ENV_PREFIX=
# SETTLY_CONFIG_PATH=
# SETTLY_LOG_LEVEL=info
# SETTLY_WATCH_ENABLED=false

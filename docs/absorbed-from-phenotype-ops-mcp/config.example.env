# Example environment for phenotype-ops-mcp
# Copy these values into your local shell, launchd plist, or container runtime.
# Do not commit real production endpoints or secrets.
#
# All config values have sensible defaults. Set only the vars you need to
# override for your environment.

# =============================================================================
# OPS provider settings
# =============================================================================

# Cloud provider slug passed to the ops library (onprem, gcp, aws, etc.)
# OPS_PROVIDER=onprem

# Nanovms kernel version string used when building instance images.
# OPS_KERNEL_VERSION=0.1.53-arm

# =============================================================================
# MCP Server settings
# =============================================================================

# Logging verbosity: debug | info | warn | error
# LOG_LEVEL=info

# Comma-separated tool names exposed by the server.
# TOOL_ALLOWLIST=health,dispatch,delegate

# Maximum allowed execution time for a delegated call.
# MAX_EXEC_TIMEOUT=30s

# Maximum number of parallel delegated calls.
# MAX_PARALLEL=4

# Required OmniRoute base URL.
OMNIROUTE_URL=http://127.0.0.1:20128

# Path for the emitted tools.json manifest (--dump-tools output).
# DUMP_TOOLS_PATH=tools.json

# =============================================================================
# Cheap LLM bridge settings
# =============================================================================

# Python interpreter path for the cheap-llm-mcp subprocess.
# CHEAP_LLM_PYTHON_BIN=python3

# Working directory containing cheap_llm_mcp/.
# CHEAP_LLM_WORK_DIR=providers/cheap_llm

# Python module to invoke (e.g. cheap_llm_mcp.cli).
# CHEAP_LLM_MODULE=cheap_llm_mcp.cli

# Max wall-clock time for a single completion request.
# CHEAP_LLM_TIMEOUT=30s

# Initial stdio scan buffer size in bytes.
# CHEAP_LLM_BUFFER_INIT=65536

# Maximum stdio scan buffer size in bytes.
# CHEAP_LLM_BUFFER_MAX=1048576

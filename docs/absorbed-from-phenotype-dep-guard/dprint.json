{
  "$schema": "https://dprint.dev/schemas/v0.json",
  "projectType": "open",
  "incremental": true,
  "indentWidth": 4,
  "lineWidth": 120,
  "includes": [
    "**/*.{py,rs,toml,json,yaml,yml,md,sh}"
  ],
  "excludes": [
    "**/target",
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/.git",
    "**/*.egg-info",
    "dist",
    "build"
  ],
  "plugins": [
    "https://plugins.dprint.dev/python-1.0.4.wasm",
    "https://plugins.dprint.dev/ruff-0.4.0.wasm",
    "https://plugins.dprint.dev/rustfmt-0.1.0.wasm",
    "https://plugins.dprint.dev/toml-0.6.0.wasm",
    "https://plugins.dprint.dev/json-0.19.0.wasm",
    "https://plugins.dprint.dev/markdown-0.17.0.wasm"
  ]
}

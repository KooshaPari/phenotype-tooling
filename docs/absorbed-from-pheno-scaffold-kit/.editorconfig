# EditorConfig — tier-0 hygiene
# Per ADR-023 Rule 1.1: every substrate ships with .editorconfig

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml}]
indent_size = 2

[Makefile,justfile]
indent_style = tab

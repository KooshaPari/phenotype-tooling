{
  "$schema": "https://raw.githubusercontent.com/KooshaPari/phenotype-py-utils/main/config/schema.json",
  "description": "phenotype-py-utils example configuration (JSON format)",

  "log": {
    "level": "INFO",
    "json_output": false
  },

  "app": {
    "environment": "development",
    "shutdown_timeout": 30
  },

  "database": {
    "host": "localhost",
    "port": 5432,
    "name": "phenotype",
    "max_connections": 10,
    "pool_timeout": 5.0
  },

  "http": {
    "timeout": 30.0,
    "max_retries": 3,
    "backoff_factor": 0.5
  },

  "features": {
    "telemetry": true,
    "verbose_logging": false
  }
}

# EditorConfig — pheno-drift-detector
# https://editorconfig.org
#
# Python-first repo (single-file module, stdlib only). All editors should
# default to 4-space indent for Python, LF line endings, and trim trailing
# whitespace except for Markdown (where trailing 2-space is significant).

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.{yml,yaml,toml,json}]
indent_size = 2

[*.md]
# Markdown uses trailing 2-space for hard line breaks; preserve as-is.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{bat,cmd}]
end_of_line = crlf

[*.sh]
end_of_line = lf

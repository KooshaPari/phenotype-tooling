install_git_hooks() {
    if [[ ! -d ".git" ]]; then
        echo -e "${RED}Not a git repository${NC}"
        exit 1
    fi
    
    echo -e "${BLUE}Installing git hooks...${NC}"
    
    # Pre-commit hook
    cat > .git/hooks/pre-commit << 'EOF'
#!/bin/bash
echo "🌊 KodeVibe - Pre-commit scan..."
kodevibe scan --vibes security,code,file --staged --ci
exit $?
EOF

    # Pre-push hook  
    cat > .git/hooks/pre-push << 'EOF'
#!/bin/bash
echo "🌊 KodeVibe - Pre-push validation..."
kodevibe scan --vibes security,code,performance,git --ci
exit $?
EOF

    chmod +x .git/hooks/pre-commit .git/hooks/pre-push
    
    echo -e "${GREEN}✓ Git hooks installed${NC}"
}

uninstall_git_hooks() {
    rm -f .git/hooks/pre-commit .git/hooks/pre-push
    echo -e "${GREEN}✓ Git hooks removed${NC}"
}

test_git_hooks() {
    echo -e "${BLUE}Testing git hooks...${NC}"
    
    if [[ -x ".git/hooks/pre-commit" ]]; then
        echo "Testing pre-commit hook..."
        .git/hooks/pre-commit
    fi
    
    if [[ -x ".git/hooks/pre-push" ]]; then
        echo "Testing pre-push hook..."
        .git/hooks/pre-push
    fi
}


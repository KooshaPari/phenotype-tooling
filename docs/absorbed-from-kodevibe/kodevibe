apply_exclusions() {
    local file_list="$1"
    shift
    local exclude_patterns=("$@")
    
    # Default exclusions
    local default_exclusions=(
        "node_modules/"
        ".git/"
        ".svn/"
        ".hg/"
        "coverage/"
        "dist/"
        "build/"
        "target/"
        "vendor/"
        ".venv/"
        "venv/"
        "__pycache__/"
        ".pytest_cache/"
        ".mypy_cache/"
        ".tox/"
        ".coverage"
        "*.min.js"
        "*.min.css"
        "*.map"
        "*.log"
        "*.tmp"
        "*.swp"
        "*~"
    )
    
    # Combine default and custom exclusions
    local all_exclusions=("${default_exclusions[@]}" "${exclude_patterns[@]}")
    
    # Filter out excluded files
    local temp_file="$KODEVIBE_TEMP_DIR/filtered_files.txt"
    cp "$file_list" "$temp_file"
    
    for pattern in "${all_exclusions[@]}"; do
        grep -v "$pattern" "$temp_file" > "$temp_file.new" 2>/dev/null || true
        mv "$temp_file.new" "$temp_file"
    done
    
    mv "$temp_file" "$file_list"
}

filter_staged_files() {
    local file_list="$1"
    local staged_files="$KODEVIBE_TEMP_DIR/staged_files.txt"
    
    git diff --cached --name-only > "$staged_files"
    
    # Only keep files that are both in our list and staged
    grep -F -f "$staged_files" "$file_list" > "$file_list.tmp" || true
    mv "$file_list.tmp" "$file_list"
}

filter_diff_files() {
    local file_list="$1"
    local diff_target="$2"
    local diff_files="$KODEVIBE_TEMP_DIR/diff_files.txt"
    
    git diff --name-only "$diff_target" > "$diff_files"
    
    # Only keep files that are both in our list and changed
    grep -F -f "$diff_files" "$file_list" > "$file_list.tmp" || true
    mv "$file_list.tmp" "$file_list"
}


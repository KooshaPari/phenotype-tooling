# 4SGM Chatbot Environment Variables
# Copy this file to .env and fill in your values

# Environment
STAGE=local

# LLM Configuration - For local development with proxy
ANTHROPIC_API_KEY=dummy-not-used
ANTHROPIC_BASE_URL=http://localhost:8317
CLAUDE_MODEL=claude-haiku-4-5-20251001

# If using real Anthropic API (not proxy)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# CLAUDE_MODEL=claude-3-5-sonnet-20241022

# If using OpenRouter for LLM
# ANTHROPIC_API_KEY=sk-or-v1-xxxxxxxx
# ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1
# CLAUDE_MODEL=anthropic/claude-3.5-sonnet

# Embeddings - OpenRouter + Gemini
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=google/gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Supabase Configuration - REQUIRED (Cloud-only, no local fallback)
# Get these from your Supabase project at https://app.supabase.com
# Navigate to: Project Settings > API > URL and anon/public key
# Example: https://your-project.supabase.co and eyJhbGc...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# API Configuration
API_BASE_URL=http://localhost:8000

# Langfuse Observability
# Get your keys at https://cloud.langfuse.com or self-hosted instance
# Public Key (safe to expose, used for client-side tracing)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Secret Key (keep private, used for server-side authentication)
LANGFUSE_SECRET_KEY=sk-lf-YOUR_KEY_HERE

# Langfuse Host
# For Langfuse Cloud: https://cloud.langfuse.com
# For self-hosted: https://your-langfuse-instance.com
LANGFUSE_HOST=https://cloud.langfuse.com

# Langfuse Environment
# development, staging, or production
LANGFUSE_ENV=development

# Langfuse Sampling Rate (0.0 to 1.0)
# 1.0 = 100% of traces captured (dev/testing)
# 0.1 = 10% of traces captured (production to save costs)
LANGFUSE_SAMPLE_RATE=1.0

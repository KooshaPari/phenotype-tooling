{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "db/**/*.ts",
    "lib/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "__tests__",
    "coverage",
    "e2e",
    "playwright-report",
    "test-results",
    "drizzle.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts"
  ]
}

{
  "name": "4sgm-chatbot-widget",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest --run --exclude 'node_modules/**' --exclude 'dist/**' --exclude '.next/**'",
    "test:watch": "vitest --exclude 'node_modules/**' --exclude 'dist/**' --exclude '.next/**'",
    "test:coverage": "vitest --run --coverage --exclude 'node_modules/**' --exclude 'dist/**' --exclude '.next/**'",
    "test:e2e": "playwright test",
    "tsc": "tsc --noEmit -p tsconfig.app.json",
    "audit:check": "npm run tsc 2>&1 | node scripts/analyze-errors.js",
    "audit:fix": "npm run eslint -- --fix src/ && npm run tsc",
    "eslint": "eslint --ext .ts,.tsx",
    "eslint:fix": "eslint --ext .ts,.tsx --fix"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.15",
    "@ai-sdk/openai": "^3.0.12",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-toast": "^1.2.2",
    "@supabase/supabase-js": "^2.81.1",
    "@typescript/native-preview": "^7.0.0-dev.20260119.1",
    "ai": "^6.0.168",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.7",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.11.0",
    "next": "16.2.4",
    "postgres": "^3.4.7",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^10",
    "eslint-config-next": "16.2.4",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.2.4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "minimatch": ">=3.1.4",
    "ajv": ">=8.17.1",
    "esbuild": ">=0.25.0"
  }
}

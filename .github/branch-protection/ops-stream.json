{
  "_comment": "Branch protection override for the ops release stream (observability + release tooling). ptx + coverage + mutation + license + sbom-diff required; extra checks for signed-release + cosign-verification.",
  "branch": "main",
  "protection": {
    "required_status_checks": {
      "strict": true,
      "contexts": [
        "ptx / governance",
        "coverage",
        "mutation-score",
        "license-check",
        "sbom-diff",
        "signed-release",
        "cosign-verification"
      ]
    },
    "enforce_admins": false,
    "required_pull_request_reviews": {
      "required_approving_review_count": 2,
      "dismiss_stale_reviews": true,
      "require_code_owner_reviews": true,
      "require_last_push_approval": true
    },
    "restrictions": {
      "users": [],
      "teams": ["ops-stream-maintainers"]
    },
    "required_signatures": true,
    "linear_history": true,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "block_creations": false,
    "required_conversation_resolution": true,
    "lock_branch": false,
    "allow_fork_syncing": false
  },
  "stream": "ops-stream",
  "member_filter": {
    "paths": [
      "crates/phenotype-tooling-observability/**",
      "crates/sbom-gen/**",
      "crates/release-cut/**",
      "crates/ptx/**"
    ]
  }
}
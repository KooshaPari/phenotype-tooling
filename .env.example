# Phenotype-tooling observability — env vars
# Set OTEL_EXPORTER_OTLP_ENDPOINT to a running otel/opentelemetry-collector-contrib
# instance. hook-entry (Claude Code PreToolUse hook) and other CI-facing bins will
# emit spans + metrics there.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=hook-entry
OTEL_RESOURCE_ATTRIBUTES=service.namespace=phenotype-tooling,deployment.environment=local
RUST_LOG=info,hook_entry=debug,phenotype_tooling_observability=debug